      {
        "say": "pet app",
        "means": "the whole set: one repo, one pet and its app",
        "retired": []
      },
      {
        "say": "pet",
        "means": "the character itself, by name",
        "retired": [
          "pixel twin"
        ]
      },
      {
        "say": "app",
        "means": "the full window that opens when you double-click the pet: a web app or a Windows app",
        "retired": [
          "pet app's app",
          "application interface",
          "pet interface",
          "local interface",
          "browser companion"
        ]
      },
      {
        "say": "desktop pet",
        "means": "the small pet that sits on the Windows desktop above other windows",
        "retired": [
          "pet app icon",
          "desktop companion"
        ]
      },
      {
        "say": "bubble",
        "means": "a short line that pops up over the pet; the pet talking",
        "retired": [
          "speech bubble",
          "chat bubble"
        ]
      },
      {
        "say": "quick chat",
        "means": "the small box that opens from the desktop pet so you can type to it",
        "retired": [
          "pet app icon chat"
        ]
      },
      {
        "say": "app icon",
        "means": "the still picture on the taskbar, a shortcut or a browser tab",
        "retired": []
      },
      {
        "say": "pet well",
        "means": "the square where the pet sits inside its app",
        "retired": [
          "pet frame"
        ]
      }
